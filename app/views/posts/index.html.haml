.background
  .user
    = render 'layouts/user_profile'
  .post
    .box.all-posts#post-box
      %ul
        %li#posts-bar
          = render partial: 'posts_bar'
        - if @posts.any?
          .posts
            = render partial: 'post', collection: @posts, as: :post
        - else
          = render partial: 'no_posts'
