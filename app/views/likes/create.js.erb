$("#like-form-<%= @likeable.id %>").replaceWith('<%= escape_javascript(render("unlike")) %>');

<% if @likeable.class.name == "Post" %>
  $("#comments-post-<%= @likeable.id %> #likes-count").html('<%= escape_javascript("#{pluralize(@likeable.likes_count, 'Like')}") %>');
<% else %>
  $("#likes-count-<%= @likeable.id %>").html('<%= escape_javascript("#{pluralize(@likeable.likes_count, 'Like')}") %>');
<% end %>
